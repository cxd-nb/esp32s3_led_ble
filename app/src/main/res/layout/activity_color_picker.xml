<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="颜色调节"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <com.example.esp32s3_led_ble.ColorPickerView
        android:id="@+id/colorPicker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black" />

    <View
        android:id="@+id/viewColorPreview"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="色号： " android:textColor="@color/white" />
        <EditText
            android:id="@+id/etColorHex"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="#FFFFFF"
            android:textColorHint="#888888"
            android:textColor="@color/white"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 新增：亮度调节 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="亮度" android:textColor="@color/white" android:layout_marginTop="12dp" />
    <SeekBar
        android:id="@+id/seekBrightnessPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="100"
        android:progressTint="@color/primary"
        android:thumbTint="@color/primary_dark" />

    <Button
        android:id="@+id/btnColorDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="完成"
        android:textSize="18sp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/black"
        android:layout_marginTop="16dp" />

</LinearLayout>